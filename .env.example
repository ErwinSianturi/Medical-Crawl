# Medical Article Crawler - Environment Configuration
# Copy this file to .env and adjust variables as required for your environment.

# HTTP Server Port (default: 8081)
PORT=8081

# HTTP Server Host Interface (default: 0.0.0.0 for containerized and network access)
HOST=0.0.0.0

# Timezone for daily CRON crawler and logs (default: Asia/Jakarta)
TZ=Asia/Jakarta

# Frontend Web UI Assets Directory (default: web)
WEB_DIR=web

# Scraped Articles JSON Output Directory (default: output)
OUTPUT_DIR=output

# Crawler Settings
CRAWLER_WORKERS=3
CRAWLER_DEFAULT_LIMIT=20
CRAWLER_TIMEOUT_SECONDS=60
